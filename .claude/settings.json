{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-attr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(.\\scripts\\build.ps1:*)",
      "PowerShell(.\\scripts\\capture.ps1:*)",
      "Bash(./scripts/build.sh:*)"
    ]
  }
}
