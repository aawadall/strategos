{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategos.local/schemas/elevation.v1.json",
  "title": "Strategos elevation grid v1",
  "type": "object",
  "required": ["schema", "name", "width", "height", "metresPerCell", "origin", "elevationMetres"],
  "properties": {
    "schema": { "const": "strategos.elevation.v1" },
    "name": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 8 },
    "height": { "type": "integer", "minimum": 8 },
    "metresPerCell": { "type": "number", "exclusiveMinimum": 0 },
    "origin": {
      "type": "object",
      "required": ["zone", "band", "easting", "northing"],
      "properties": {
        "zone": { "type": "integer", "minimum": 1, "maximum": 60 },
        "band": { "type": "string", "pattern": "^[A-Z]$" },
        "easting": { "type": "number" },
        "northing": { "type": "number" }
      }
    },
    "elevationMetres": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 64
    },
    "source": {
      "type": "object",
      "properties": {
        "dataset": { "type": "string" },
        "licence": { "type": "string" },
        "url": { "type": "string" }
      }
    }
  }
}
