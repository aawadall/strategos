# =============================================================================
# Strategos — .gitignore
# Unity 6 project — keep source and assets; exclude generated/cache files.
# =============================================================================

# Unity generated cache and temp directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/

# Unity auto-generated project files (regenerated on each Editor open)
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt
*.stackdump

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# Windows metadata
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# JetBrains IDEs
.idea/
*.iml

# Visual Studio
.vs/
*.vsp
*.vsps

# VS Code — workspace files are regenerated by the Unity VS Code package
.vscode/

# Claude Code — .claude/settings.json is shared and tracked; local overrides are personal
.claude/settings.local.json

# TextMeshPro Essential Resources ARE committed. They live in a .unitypackage
# that only an interactive menu click imports, so a batch/CI build without them
# produces a player where TMP_Settings.instance is null and no text renders.
# Regenerate with: Strategos → Import TMP Essential Resources

# Addressables build output (generated)
Assets/AddressableAssetsData/AddressableAssetSettings.asset
ServerData/

# Unity Package Manager lock file — let each dev resolve locally
Packages/packages-lock.json

# AI model outputs (generated during training, not source)
Assets/AI/Models/Generated/

# Build CI artifacts
Artifacts/

# Batch-mode Editor logs. The documented bake commands write these to the repo
# root (-logFile sheet.log, -logFile map-sheet.log).
*.log

# Research — third-party reference PDFs stay gitignored; authored notes may ship.
# Use Research/* (not Research/) so un-ignore rules can re-include children.
Research/*
!Research/README.md
!Research/historical/
!Research/historical/**
